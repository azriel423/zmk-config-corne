#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        ae {
            bindings = <&kp RA(Q)>;
            key-positions = <1 13>;
        };

        sz {
            bindings = <&kp RA(S)>;
            key-positions = <3 15>;
        };

        ue {
            bindings = <&kp RA(Y)>;
            key-positions = <8 20>;
        };

        oe {
            bindings = <&kp RA(P)>;
            key-positions = <10 22>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <11 24>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <25 26>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <14 26>;
        };

        pasta {
            bindings = <&kp LC(V)>;
            key-positions = <26 27>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <18 30>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <19 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp F     &kp P  &kp B        &kp J      &kp L  &kp U              &kp Y    &kp X     &kp BSPC
&kp EQUAL  &kp A  &kp R  &kp S     &kp T  &kp G        &kp M      &kp N  &kp E              &kp I    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp V  &kp C     &kp D  &kp O        &kp K      &kp H  &kp COMMA          &kp DOT  &kp FSLH  &kp MINUS
                         &kp LGUI  &mo 1  &kp ENTER    &kp SPACE  &mo 2  &kp RIGHT_CONTROL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCLAMATION  &kp AT        &kp HASH      &kp RA(N5)    &kp PERCENT    &kp CARET      &kp AMPS        &kp ASTRK         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BSPC
&none      &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6   &kp N7          &kp N8            &kp N9                &kp N0                 &kp PIPE
&kp LSHFT  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans         &kp BACKSLASH  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp RIGHT_BRACE        &trans
                                          &kp LGUI      &trans        &kp SPACE      &kp RET        &trans          &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9    &kp TILDE  &trans    &kp UP_ARROW  &trans     &trans  &kp BSPC
&kp LCTRL  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6    &trans     &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&kp LSHFT  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3    &trans     &trans    &trans        &trans     &trans  &trans
                           &kp LGUI         &kp KP_NUMBER_0  &kp SPACE          &kp RET    &trans    &kp RALT
            >;
        };
    };
};

&led_strip { chain-length = <21>; };
